		buffer.writeu32(ram, 0x100, c[3])
		cpu.regs[2] = 0x80000100
		cpu.regs[3] = c[4]
		buffer.writeu32(ram, 0, c[2])
		cpu:step(1, 0)
		local mem = buffer.readu32(ram, 0x100)
		if cpu.regs[4] ~= c[5] or mem ~= c[6] then
			table.insert(failures, string.format("%s(mem %08X, %08X) rd=%08X mem=%08X, expected %08X %08X", c[1], c[3], c[4], cpu.regs[4], mem, c[5], c[6]))
		end
	end
	test(string.format("CPU matches the reference (%d ALU, %d load, %d store, %d branch, %d AMO cases)", #CASES, #MEM, #STORES, #BRANCHES, #AMOS), function()
		if #failures > 0 then
			error(#failures .. " mismatches, e.g.:\n  " .. table.concat(failures, "\n  ", 1, math.min(#failures, 12)))
		end
	end)
