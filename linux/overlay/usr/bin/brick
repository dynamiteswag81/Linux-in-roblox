#!/bin/sh
# brick - the Brick Linux package manager.
#
# Packages live in the Community Workshop and are fetched through the host link.
# A package is a .tar.gz containing:
#     BRICK     manifest: name=, version=, description=, depends= (one per line)
#     files/    everything under here is installed relative to /
#
# Set BRICK_ROOT to install into another root (brickstrap uses this).

ROOT="${BRICK_ROOT:-}"
DB="$ROOT/var/lib/brick/local"

die() { echo "brick: $*" >&2; exit 1; }
info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }

usage() {
	cat <<'EOF'
usage: brick <command> [args]

  search [words]      search the Community Workshop          (-Ss)
  info <pkg>          show details about a package           (-Si)
  install <pkg>...    download and install packages          (-S)
  remove <pkg>...     uninstall packages                     (-R)
  list                list installed packages                (-Q)
  files <pkg>         list files owned by an installed package (-Ql)
  upgrade             update all installed packages          (-Syu)
  new <name>          create a package skeleton to publish
  publish <dir>       publish a package directory to the Workshop
EOF
}

manifest_get() { # <file> <key>
	sed -n "s/^$2=//p" "$1" | head -n 1
}

installed_version() {
	[ -f "$DB/$1/BRICK" ] && manifest_get "$DB/$1/BRICK" version
}

do_search() {
	hostlink pkg.search "$*" || exit 1
}

do_info() {
	[ -n "$1" ] || die "info: which package?"
	hostlink pkg.info "$1" || exit 1
	v="$(installed_version "$1")"
	[ -n "$v" ] && echo "Installed:   $v"
}

install_one() { # <pkg> [reinstall]
	pkg="$1"
	case "$pkg" in *[!a-z0-9._+-]*|"") die "bad package name '$pkg'" ;; esac
	if [ -z "$2" ] && [ -d "$DB/$pkg" ]; then
		echo "$pkg is already installed ($(installed_version "$pkg"))"
		return 0
	fi
	tmp="$(mktemp -d /tmp/brick.XXXXXX)" || die "cannot create temp dir"
	info "Downloading $pkg..."
	if ! hostlink pkg.get "$pkg" > "$tmp/pkg.tgz"; then
		rm -rf "$tmp"
		die "could not download $pkg"
	fi
	mkdir -p "$tmp/x"
	if ! tar -xzf "$tmp/pkg.tgz" -C "$tmp/x"; then
		rm -rf "$tmp"
		die "$pkg: package archive is damaged"
	fi
	[ -f "$tmp/x/BRICK" ] || { rm -rf "$tmp"; die "$pkg: missing BRICK manifest"; }

	for dep in $(manifest_get "$tmp/x/BRICK" depends); do
		[ -d "$DB/$dep" ] || install_one "$dep"
	done

	info "Installing $pkg $(manifest_get "$tmp/x/BRICK" version)..."
	[ -n "$2" ] && remove_files "$pkg"
	mkdir -p "$DB/$pkg"
	cp "$tmp/x/BRICK" "$DB/$pkg/BRICK"
	if [ -d "$tmp/x/files" ]; then
		(cd "$tmp/x/files" && find . ! -type d) | sed 's|^\./|/|' > "$DB/$pkg/files"
		cp -a "$tmp/x/files/." "$ROOT/"
	else
		: > "$DB/$pkg/files"
	fi
	if [ -x "$tmp/x/install.sh" ]; then
		if [ -n "$ROOT" ]; then
			chroot "$ROOT" /bin/sh -c "$(cat "$tmp/x/install.sh")" || echo "warning: $pkg install script failed"
		else
			"$tmp/x/install.sh" || echo "warning: $pkg install script failed"
		fi
	fi
	rm -rf "$tmp"
}

remove_files() {
	[ -f "$DB/$1/files" ] || return 0
	while read -r f; do
		rm -f "$ROOT$f"
	done < "$DB/$1/files"
}

do_install() {
	[ $# -gt 0 ] || die "install: which packages?"
	for p in "$@"; do install_one "$p"; done
}

do_remove() {
	[ $# -gt 0 ] || die "remove: which packages?"
	for p in "$@"; do
		[ -d "$DB/$p" ] || die "$p is not installed"
		info "Removing $p..."
		remove_files "$p"
		rm -rf "$DB/$p"
	done
}

do_list() {
	[ -d "$DB" ] || return 0
	for d in "$DB"/*; do
		[ -f "$d/BRICK" ] || continue
		printf '%s %s\n' "$(basename "$d")" "$(manifest_get "$d/BRICK" version)"
	done
}

do_files() {
	[ -f "$DB/$1/files" ] || die "$1 is not installed"
	cat "$DB/$1/files"
}

do_upgrade() {
	for d in "$DB"/*; do
		[ -f "$d/BRICK" ] || continue
		p="$(basename "$d")"
		have="$(manifest_get "$d/BRICK" version)"
		want="$(hostlink pkg.version "$p" 2>/dev/null)"
		if [ -n "$want" ] && [ "$want" != "$have" ]; then
			install_one "$p" reinstall
		fi
	done
	info "Everything is up to date."
}

do_new() {
	name="$1"
	case "$name" in *[!a-z0-9._+-]*|"") die "new: package names use a-z, 0-9, . _ + -" ;; esac
	[ -e "$name" ] && die "$name already exists"
	mkdir -p "$name/files/usr/bin"
	cat > "$name/BRICK" <<EOF
name=$name
version=1.0
description=Describe your package here
depends=
EOF
	cat > "$name/files/usr/bin/$name" <<EOF
#!/bin/sh
echo "Hello from $name!"
EOF
	chmod +x "$name/files/usr/bin/$name"
	echo "Created ./$name. Edit $name/BRICK and put files under $name/files/,"
	echo "then run: brick publish $name"
}

do_publish() {
	dir="${1%/}"
	[ -d "$dir" ] || die "publish: '$dir' is not a directory"
	[ -f "$dir/BRICK" ] || die "publish: $dir/BRICK manifest is missing (try: brick new <name>)"
	name="$(manifest_get "$dir/BRICK" name)"
	[ -n "$name" ] || die "publish: BRICK needs a name= line"
	info "Packing $name $(manifest_get "$dir/BRICK" version)..."
	tmp="$(mktemp /tmp/brick.XXXXXX)" || die "cannot create temp file"
	(cd "$dir" && tar -czf "$tmp" BRICK $( [ -d files ] && echo files ) $( [ -f install.sh ] && echo install.sh )) \
		|| { rm -f "$tmp"; die "could not pack $dir"; }
	info "Uploading to the Community Workshop..."
	hostlink -i "$tmp" pkg.publish "$name"
	status=$?
	rm -f "$tmp"
	exit $status
}

cmd="$1"
[ $# -gt 0 ] && shift
case "$cmd" in
	search|-Ss) do_search "$@" ;;
	info|-Si) do_info "$@" ;;
	install|-S) do_install "$@" ;;
	remove|-R|-Rs) do_remove "$@" ;;
	list|-Q) do_list ;;
	files|-Ql) do_files "$@" ;;
	upgrade|-Syu|-Su) do_upgrade ;;
	new) do_new "$@" ;;
	publish) do_publish "$@" ;;
	""|help|-h|--help) usage ;;
	*) usage; exit 1 ;;
esac
