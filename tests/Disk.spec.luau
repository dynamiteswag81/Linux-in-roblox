return function(test, root, require)
	local Disk = require(root.LinuxVM.Emulator.Disk)

	test("disk reads zeros, writes across block boundaries", function()
		local d = Disk.new(64 * 1024)
		local src = buffer.fromstring(string.rep("x", 5000))
		d:writeFrom(4000, 5000, src, 0)
		local out = buffer.create(6000)
		d:readInto(3500, 6000, out, 0)
		local s = buffer.tostring(out)
		assert(string.sub(s, 1, 500) == string.rep("\0", 500))
		assert(string.sub(s, 501, 5500) == string.rep("x", 5000))
		assert(string.sub(s, 5501) == string.rep("\0", 500))
		assert(d:usedBlocks() == 3, d:usedBlocks())
	end)

	test("whole-block zero writes free the block", function()
		local d = Disk.new(64 * 1024)
		d:writeFrom(0, 4096, buffer.fromstring(string.rep("a", 4096)), 0)
		assert(d:usedBlocks() == 1)
		d:writeFrom(0, 4096, buffer.create(4096), 0)
		assert(d:usedBlocks() == 0)
	end)

	test("serialize/deserialize round trip", function()
		local d = Disk.new(1024 * 1024)
		d:writeFrom(12345, 11, buffer.fromstring("hello world"), 0)
		d:writeFrom(700000, 4, buffer.fromstring("abcd"), 0)
		local blob = d:serialize()
		local e = Disk.deserialize(blob)
		assert(e.size == d.size and e:usedBlocks() == 2)
		local out = buffer.create(11)
		e:readInto(12345, 11, out, 0)
		assert(buffer.tostring(out) == "hello world")
		assert(buffer.len(blob) < 200, "two blocks should compress well, got " .. buffer.len(blob))
	end)
end
