return function(test, root, require)
	local Terminal = require(root.LinuxVM.Terminal.Terminal)

	local function fresh(cols, rows)
		local t = Terminal.new(cols or 10, rows or 4)
		local responses = {}
		t.onResponse = function(d)
			table.insert(responses, d)
		end
		return t, responses
	end

	test("prints text and wraps at the right margin", function()
		local t = fresh(5, 3)
		t:write("hello world")
		assert(t:getLineText(1) == "hello", t:getLineText(1))
		assert(t:getLineText(2) == " worl", t:getLineText(2))
		assert(t:getLineText(3) == "d    ", t:getLineText(3))
	end)

	test("deferred wrap: CR after filling a line stays on that line", function()
		local t = fresh(5, 3)
		t:write("abcde\r")
		assert(t.cursorRow == 1 and t.cursorCol == 1)
	end)

	test("scrolls when writing past the bottom", function()
		local t = fresh(4, 2)
		t:write("1\r\n2\r\n3")
		assert(t:getLineText(1) == "2   ", t:getLineText(1))
		assert(t:getLineText(2) == "3   ")
	end)

	test("cursor positioning and erase", function()
		local t = fresh(10, 3)
		t:write("XXXXXXXXXX\r\nYYYYYYYYYY")
		t:write("\27[1;4H\27[K")
		assert(t:getLineText(1) == "XXX       ", t:getLineText(1))
		t:write("\27[2J")
		assert(t:toText() == "\n\n")
		t:write("\27[2;3Hz")
		assert(t:getLineText(2) == "  z       ")
	end)

	test("SGR colors and attributes are recorded per cell", function()
		local t = fresh(10, 2)
		t:write("\27[1;31;44mA\27[0mB\27[38;5;200mC")
		local a1, a2, a3 = t.attrs[1][1], t.attrs[1][2], t.attrs[1][3]
		assert(a1 % 512 == 1, "fg red")
		assert((a1 // 512) % 512 == 4, "bg blue")
		assert(bit32.btest(a1 // 262144, Terminal.FLAG_BOLD), "bold")
		assert(a2 % 512 == Terminal.DEFAULT_COLOR, "reset fg")
		assert(a3 % 512 == 200, "256 color")
	end)

	test("answers cursor position and device attribute queries", function()
		local t, responses = fresh(10, 5)
		t:write("\27[3;4H\27[6n\27[c")
		assert(responses[1] == "\27[3;4R", responses[1])
		assert(string.sub(responses[2], 1, 3) == "\27[?")
	end)

	test("scroll region with reverse index", function()
		local t = fresh(3, 4)
		t:write("a\r\nb\r\nc\r\nd")
		t:write("\27[2;3r\27[2;1H\27M")
		assert(t:toText() == "a\n\nb\nd", t:toText())
	end)

	test("insert and delete lines and characters", function()
		local t = fresh(5, 3)
		t:write("abcde\r\n12345")
		t:write("\27[1;2H\27[2P")
		assert(t:getLineText(1) == "ade  ", t:getLineText(1))
		t:write("\27[2@")
		assert(t:getLineText(1) == "a  de", t:getLineText(1))
		t:write("\27[1;1H\27[L")
		assert(t:getLineText(1) == "     " and t:getLineText(2) == "a  de")
		t:write("\27[M")
		assert(t:getLineText(1) == "a  de")
	end)

	test("alternate screen restores the main screen", function()
		local t = fresh(5, 2)
		t:write("main")
		t:write("\27[?1049h\27[HALT")
		assert(t:getLineText(1) == "ALT  ")
		t:write("\27[?1049l")
		assert(t:getLineText(1) == "main ", t:getLineText(1))
		assert(t.cursorCol == 5)
	end)

	test("application cursor mode is tracked", function()
		local t = fresh()
		t:write("\27[?1h")
		assert(t.applicationCursor)
		t:write("\27[?1l")
		assert(not t.applicationCursor)
	end)

	test("UTF-8 and DEC line drawing", function()
		local t = fresh(5, 1)
		t:write("é\27(0lqk\27(B")
		assert(t.lines[1][1] == "é")
		assert(t.lines[1][2] == "┌" and t.lines[1][3] == "─" and t.lines[1][4] == "┐")
	end)

	test("tabs and backspace", function()
		local t = fresh(20, 1)
		t:write("a\tb\bc")
		assert(t:getLineText(1) == "a       c           ", t:getLineText(1))
	end)

	test("OSC title is parsed and not printed", function()
		local t = fresh(10, 1)
		local title
		t.onTitle = function(s)
			title = s
		end
		t:write("\27]0;my title\7ok")
		assert(title == "my title")
		assert(t:getLineText(1) == "ok        ")
	end)

	test("snapshot reproduces screen, modes and mid-sequence parser state", function()
		local a = fresh(8, 3)
		a:write("\27[1;32mhi\27[0m é\r\n\27[?1hline2\27[?1049h\27[Halt")
		a:write("\27[3") -- in the middle of a CSI sequence
		local b = fresh(8, 3)
		b:loadSnapshot(a:snapshot())
		assert(b:toText() == a:toText(), b:toText())
		assert(b.applicationCursor)
		a:write("1mX\27[?1049l")
		b:write("1mX\27[?1049l")
		assert(b:toText() == a:toText(), "after leaving alt screen: " .. b:toText())
		assert(b.attrs[1][1] == a.attrs[1][1])
		assert(b.cursorRow == a.cursorRow and b.cursorCol == a.cursorCol)
	end)
end
